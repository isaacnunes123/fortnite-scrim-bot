# Token do bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# ID da aplicação (General Information → Application ID)
DISCORD_CLIENT_ID=

# Client Secret (OAuth2 → Client Secret) — login do mapa compartilhado
DISCORD_CLIENT_SECRET=

# Servidor das scrims (opcional; se vazio, usa o primeiro servidor do bot)
DISCORD_GUILD_ID=

# Cargos que podem entrar no painel (IDs, separados por vírgula)
ADMIN_ROLE_IDS=

# Senha para entrar no painel web (só vale se ADMIN_ROLE_IDS estiver vazio)
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de login
SESSION_SECRET=troque-este-segredo

# Porta do painel (hosts costumam injetar PORT)
PORT=3000
NODE_ENV=development

# URL pública do painel (link do mapa de drop no Discord)
# No Developer Portal → OAuth2 → Redirects, adicione:
#   http://localhost:3000/api/auth/discord/callback
PUBLIC_BASE_URL=http://localhost:3000
