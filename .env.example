# Token do bot (Discord Developer Portal → Bot → Reset Token)
# Na Vercel: usado só via API REST para conferir cargo da staff. NÃO sobe o gateway.
# No host 24/7 (Fly / Render / Railway serviço "bot"): obrigatório — é o que deixa o bot online.
DISCORD_TOKEN=

# ID da aplicação (General Information → Application ID)
DISCORD_CLIENT_ID=

# Client Secret (OAuth2 → Client Secret) — login do painel e do mapa
DISCORD_CLIENT_SECRET=

# Servidor único das scrims
DISCORD_GUILD_ID=862771292389900308

# Cargos que podem entrar no painel (IDs numéricos, separados por vírgula).
# Obrigatório. Sem isso o login Discord é recusado.
ADMIN_ROLE_IDS=

# Segredo para assinar o cookie de login (não use senha de painel)
SESSION_SECRET=troque-este-segredo

# Porta do painel (hosts 24/7 costumam injetar PORT)
PORT=3000
NODE_ENV=development

# URL pública canônica do site (sem barra no final).
# Local: http://localhost:3000
# Produção: https://buildscrims.online
PUBLIC_BASE_URL=https://buildscrims.online

# Opcional. Se vazio, o callback vira PUBLIC_BASE_URL/api/auth/discord/callback
# No Discord Developer Portal → OAuth2 → Redirects, cadastre EXATAMENTE:
#   https://buildscrims.online/api/auth/discord/callback
#   http://localhost:3000/api/auth/discord/callback
# DISCORD_REDIRECT_URI=https://buildscrims.online/api/auth/discord/callback

# Opcional. Hosts extras liberados no OAuth (www, preview Vercel, etc.)
# PUBLIC_HOSTS=www.buildscrims.online,fortnite-scrim-bot.vercel.app

# Postgres (Neon gratuito) — obrigatório na Vercel para tabelas não sumirem.
# Local/bot 24/7 pode continuar com store.json em DATA_DIR.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Pasta persistente no host 24/7 (volume). Na Vercel o disco é efêmero.
DATA_DIR=

# Token da API Yunite (Dashboard Yunite). Só no backend — nunca vai para o browser.
# Guild da API = DISCORD_GUILD_ID. Em cada tabela a staff cola o ID do torneio.
YUNITE_API_KEY=

# URL pública do processo Node do bot (sem barra no final). Só na Vercel.
# Sem isso o painel NÃO confirma online (fica “sem confirmação”), mesmo se o Discord estiver verde.
# Railway: Settings → Networking → Generate Domain. NÃO use *.railway.internal.
# Certo:  https://bot-production-xxxx.up.railway.app
# Errado: https://bot-production-xxxx.up.railway.app/
# Errado: https://bot-production-xxxx.up.railway.app/health
# BOT_PROCESS_URL=
