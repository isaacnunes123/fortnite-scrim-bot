# Token do bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# ID da aplicação (General Information → Application ID)
DISCORD_CLIENT_ID=

# Client Secret (OAuth2 → Client Secret) — login do mapa compartilhado
DISCORD_CLIENT_SECRET=

# Servidor único das scrims (o bot sai de qualquer outro)
DISCORD_GUILD_ID=862771292389900308

# Cargos que podem entrar no painel (IDs, separados por vírgula)
ADMIN_ROLE_IDS=

# Senha para entrar no painel web (só vale se ADMIN_ROLE_IDS estiver vazio)
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de login
SESSION_SECRET=troque-este-segredo

# Porta do painel (hosts costumam injetar PORT)
PORT=3000
NODE_ENV=development

# URL pública canônica do site (sem barra no final).
# Local: http://localhost:3000
# Produção no domínio da Vercel: https://buildscrims.online
# O bot/API continuam no Railway; a Vercel só serve o frontend e faz proxy de /api.
PUBLIC_BASE_URL=http://localhost:3000

# Opcional. Se vazio, o callback vira PUBLIC_BASE_URL/api/auth/discord/callback
# No Discord Developer Portal → OAuth2 → Redirects, cadastre EXATAMENTE:
#   https://buildscrims.online/api/auth/discord/callback
#   https://handsome-curiosity-production-48d3.up.railway.app/api/auth/discord/callback
#   http://localhost:3000/api/auth/discord/callback
# DISCORD_REDIRECT_URI=https://buildscrims.online/api/auth/discord/callback

# Opcional. Hosts extras liberados no OAuth (www, preview Vercel, etc.)
# PUBLIC_HOSTS=www.buildscrims.online,fortnite-scrim-bot.vercel.app

# Pasta persistente no Railway: crie um volume e aponte DATA_DIR=/data
# Sem isso, scrims e uploads somem no redeploy. Os presets também são gravados em /presets no código.
DATA_DIR=

# Token da API Yunite (Dashboard Yunite). Só no backend — nunca vai para o browser.
# Guild da API = DISCORD_GUILD_ID. Em cada scrim a staff cola o ID do torneio.
YUNITE_API_KEY=
