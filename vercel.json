{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://handsome-curiosity-production-48d3.up.railway.app/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://handsome-curiosity-production-48d3.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://handsome-curiosity-production-48d3.up.railway.app/uploads/:path*"
    },
    {
      "source": "/maps/:path*",
      "destination": "https://handsome-curiosity-production-48d3.up.railway.app/maps/:path*"
    },
    {
      "source": "/preset-files/:path*",
      "destination": "https://handsome-curiosity-production-48d3.up.railway.app/preset-files/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://handsome-curiosity-production-48d3.up.railway.app/brand/:path*"
    },
    {
      "source": "/((?!assets/|banners/).*)",
      "destination": "/index.html"
    }
  ]
}
